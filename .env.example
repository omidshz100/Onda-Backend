ONDA_ENVIRONMENT=development
ONDA_ENABLE_DOCS=false
ONDA_DATABASE_URL=postgresql+asyncpg://onda:onda@127.0.0.1:5432/onda
ONDA_API_JWT_SECRET=replace-with-at-least-32-random-characters
ONDA_JITSI_APP_ID=onda
ONDA_JITSI_APP_SECRET=replace-with-the-jitsi-secret
ONDA_JITSI_BASE_URL=https://meet.example.com
ONDA_ALLOWED_HOSTS=["localhost","127.0.0.1"]
ONDA_AUTH_RATE_LIMIT_PER_MINUTE=20
ONDA_CALL_RING_TIMEOUT_SECONDS=45

# Optional APNs incoming-call notifications. Set all four values together.
# ONDA_APNS_KEY_ID=
# ONDA_APNS_TEAM_ID=
# ONDA_APNS_BUNDLE_ID=com.example.onda
# Paste the .p8 content with line breaks encoded as \n.
# ONDA_APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

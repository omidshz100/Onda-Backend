using './main.bicep'

param location = 'polandcentral'
param namePrefix = 'ondadev2026'
param appServiceName = 'onda-api-omid-2026'
param postgresAdminUser = 'ondaadmin'
param postgresAdminPassword = '<generate-a-long-random-password>'
